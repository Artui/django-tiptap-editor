{
  "name": "django-tiptap-editor-js",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Embedded TipTap glue + esbuild dual-output build for django-tiptap-editor. Built artifacts are committed under django_tiptap_editor/static/ so consumers stay Python-only.",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/extension-character-count": "3.31.4",
    "@tiptap/extension-color": "3.31.4",
    "@tiptap/extension-font-family": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-subscript": "3.31.4",
    "@tiptap/extension-superscript": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-table-cell": "3.31.4",
    "@tiptap/extension-table-header": "3.31.4",
    "@tiptap/extension-table-row": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/extension-underline": "3.31.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "25.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
